# Copy to .env and fill in. Nothing here has a default that spends money.

# --- Auth ---
# Signs session tokens. Leave EMPTY in development: a random key is generated
# and persisted to backend/.secret_key (gitignored). MUST be set to a long
# random value in production -- there is deliberately no hardcoded fallback,
# because one in this public repo would let anyone forge a session.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set true behind HTTPS so the session cookie is never sent in clear.
COOKIE_SECURE=false

# Minimum password length. Composition rules are deliberately not enforced.
MIN_PASSWORD_LENGTH=10

# How long a session lasts, in minutes. Default is 7 days.
ACCESS_TOKEN_MINUTES=10080

# mock = deterministic, no key, no cost. anthropic = real analysis.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=high

# tfidf ships everywhere; sentence_transformer needs the [semantic] extra.
EMBEDDER=tfidf

DATABASE_URL=sqlite:///./projectrevive.db

MAX_UPLOAD_MB=20
MAX_PAGES=300
ENABLE_OCR=false

FRONTEND_ORIGIN=http://localhost:3000

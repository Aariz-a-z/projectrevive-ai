# Copy to .env and fill in. Nothing here has a default that spends money.

# --- Auth ---
# Signs session tokens. Leave EMPTY in development: a random key is generated
# and persisted to backend/.secret_key (gitignored). MUST be set to a long
# random value in production -- there is deliberately no hardcoded fallback,
# because one in this public repo would let anyone forge a session.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set true behind HTTPS so the session cookie is never sent in clear.
COOKIE_SECURE=false

# Minimum password length. Composition rules are deliberately not enforced.
MIN_PASSWORD_LENGTH=10

# How long a session lasts, in minutes. Default is 7 days.
ACCESS_TOKEN_MINUTES=10080

# --- Rate limiting ---
# Limits are per process. With multiple workers each keeps its own counters,
# so the effective limit multiplies by the worker count.
RATE_LIMIT_ENABLED=true
LOGIN_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=300
SIGNUP_ATTEMPTS_PER_IP=5
SIGNUP_WINDOW_SECONDS=3600
UPLOAD_PER_USER=20
UPLOAD_WINDOW_SECONDS=3600

# Consecutive failed sign-ins for one account before backoff begins.
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=30
LOCKOUT_MAX_SECONDS=600

# Only enable behind a proxy that OVERWRITES X-Forwarded-For. Otherwise any
# client can spoof the header and bypass every per-IP limit above. This only
# takes effect when the API is started with run.py, which wires uvicorn's own
# proxy-header option (default: on) to this setting.
TRUST_PROXY_HEADERS=false
FORWARDED_ALLOW_IPS=127.0.0.1

# mock = deterministic, no key, no cost. anthropic = real analysis.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# ~$0.25-0.40 per 20-page report. claude-haiku-5-5 is ~25x cheaper but reasons
# less well about why something is a weakness.
ANALYSIS_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Controls thinking depth and token spend.
ANALYSIS_EFFORT=high
ANALYSIS_MAX_TOKENS=16000
ANALYSIS_TIMEOUT_SECONDS=300

# tfidf ships everywhere; sentence_transformer needs the [semantic] extra.
EMBEDDER=tfidf

DATABASE_URL=sqlite:///./projectrevive.db

MAX_UPLOAD_MB=20
MAX_PAGES=300
ENABLE_OCR=false

FRONTEND_ORIGIN=http://localhost:3000
